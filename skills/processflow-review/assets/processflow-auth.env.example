# Per-company ProcessFlow / Supabase REST auth. Copy to <company>/_tooling/processflow-auth.env and fill in.
# LOCAL SECRET — do not commit/share. The PF_TOKEN (Bearer) is a short-lived JWT (~1h).
# Refresh it when fetches return 401: on processflow.neverlost.at open DevTools -> Network, click any
# request, copy the `authorization: Bearer …` value into PF_TOKEN below.
export PF_BASE='https://<project-ref>.supabase.co/rest/v1'   # same Supabase host for all neverlost companies
export PF_PROJECT='<project-uuid>'                            # the project UUID from the app URL (/projects/<uuid>/)
export PF_APIKEY='<the apikey header value (anon key)>'
export PF_TOKEN='<the authorization Bearer value (expires ~1h)>'
